# Operating system files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo

# Machine-local MCP client config (aletheore mcp-install writes an absolute
# path to whatever machine/checkout generated it - not portable, never
# meant to be shared)
.mcp.json

# Logs
*.log
logs/

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/
*.egg-info/
coverage/
coverage.xml
.coverage
.coverage.*
.cache/
.tmp/

# Python bytecode cache
__pycache__/
*.pyc

# Environment files
.env
.env.*
!.env.example

# Secret key material (GitHub App private key, etc.)
*.pem

# Persistent per-repo git checkouts (scan_worker's docker-compose bind
# mount for _ensure_persistent_checkout) - real customer repo content,
# never something to commit.
github-app/repo-checkouts/

# Aletheore prototype scan output (generated locally by `aletheore audit`)
.aletheore/

# Cloned fixture repo + built index for the retrieval-regression Bench-CI
# gate (benchmarks/retrieval-regression/build_fixture.py) - real third-party
# source, rebuilt from fixture.json's pin, never something to commit.
benchmarks/retrieval-regression/.fixture-cache/

# Machine-local dev-server launch config (points at whatever repo you're using to test
# the dashboard against - not something to share)
.claude/

# Brainstorming visual-companion mockups (local scratch, not part of the shipped site)
.superpowers/

# PR-review benchmark: results/ is working state (raw tool outputs, grounding checks,
# anonymized findings, scored results, llm judge output) — only the published deliverables
# (REPORT.md, METHODOLOGY.md, cases/) are committed. See README.md → Step 3 for details.
benchmarks/pr-review-benchmark/results/

# Repowise's local index cache (knowledge graph, embeddings, dedup/centrality caches) -
# machine-local build state, not source. Regenerated by `repowise init`/`repowise index`.
.repowise/
