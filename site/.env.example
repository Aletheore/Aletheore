# Server-only settings. Keep all credentials out of NEXT_PUBLIC_* variables.
INDIEROUTER_API_KEY=
# Public chat switch: exactly 1 turns it on (with the key above). Anything else keeps it off. Redeploy after changing.
COMPANION_LIVE_ENABLED=0
COMPANION_LIMIT_SERVICE_URL=https://app.aletheore.com/v1/internal/companion-limits
# Same distinct random >=32-character service token configured on the app server.
COMPANION_LIMIT_SERVICE_TOKEN=
# Required stable random >=32-character HMAC secret, independent of the service credential.
COMPANION_LIMIT_HMAC_SECRET=
# Before setting the switch to 1 in production: deployed ledger initialized, provider-side hard spend cap on this key,
# Vercel preview verified, privacy copy updated. Stop admissions instantly with `scripts/companion_limits.py disable`.
