{
  "$id": "https://aletheore.com/schemas/air.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Deterministic repository evidence produced by `aletheore scan`.",
  "properties": {
    "aletheore_version": {
      "type": "string"
    },
