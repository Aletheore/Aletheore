              },
              "modules": {
                "type": "array"
              }
            },
            "required": [
              "id",
              "modules"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "config_applied": {
          "type": [
            "object",
            "null"
          ]
        },
        "cross_cluster_edges": {
          "type": "array"
        },
        "layer_violations": {
          "properties": {
            "convention_detected": {
              "type": "boolean"
            },
            "layers": {
              "type": "array"
            },
            "violations": {
              "type": "array"
            }
          },
          "required": [
            "convention_detected",
            "layers",
            "violations"
