# Copy to registry.env. Nothing secret goes in this file: the Cloudflare token, the admin token and the tunnel token are FILES under ./secrets/
# (chmod 600), mounted as Docker secrets. registry.env and secrets/ are git-ignored.
COUNCIL_REGISTRY_DOMAIN=aletheorecouncil.com
COUNCIL_REGISTRY_ACCOUNT_ID=11d7a4b371f19bc415cc488c7f333ed5
COUNCIL_REGISTRY_ZONE_ID=3fe08cb4f621fa5d7fed681f03829e60
# 0 until the pool is approved; then 150 (the free zone allows 200 DNS records, this leaves room for our own)
COUNCIL_REGISTRY_SLOTS=0
COUNCIL_REGISTRY_HOST_PORT=8765
# the tunnel sidecar's network, so the registry believes the client address it forwards
COUNCIL_TRUSTED_PROXIES=172.16.0.0/12
