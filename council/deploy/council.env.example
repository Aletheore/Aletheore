# Copy to council.env, fill in, and keep it readable only by you:  chmod 600 council.env
# council.env is git-ignored. NEVER commit it, paste it into a chat, or put real values in this example file.

# --- database (the postgres container reads these too) ---
POSTGRES_USER=council
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=council
COUNCIL_PG_DSN=postgresql://council:CHANGE_ME@postgres:5432/council
COUNCIL_STORE=postgres
COUNCIL_PG_POOL=20

# --- who may connect (stage 2 style tokens until accounts arrive in Task 5): a JSON file {"name": "token"} ---
COUNCIL_TOKEN_FILE=/run/secrets/council_tokens

# --- admin: sha-256 of the admin token that unlocks /metrics (printf %s "your-admin-token" | shasum -a 256) ---
COUNCIL_ADMIN_TOKEN_HASH=CHANGE_ME

# --- the reverse proxy in front: its address(es), so X-Forwarded-For is believed only from it ---
COUNCIL_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# --- limits (defaults; Task 14 sets them from measurements) ---
COUNCIL_RATE_EVENTS_PER_MIN=300
COUNCIL_RATE_EVENTS_BURST=60
COUNCIL_RATE_IP_PER_MIN=1200
COUNCIL_RATE_IP_BURST=200
COUNCIL_MAX_ROOMS_PER_HOST=50
