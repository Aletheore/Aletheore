+// requestCount tracks the total number of requests handled by the process.
+// It is read via RequestCount and incremented once per request in ServeHTTP,
+// which net/http invokes concurrently from a separate goroutine per connection.
+var requestCount int
+
+// RequestCount returns the total number of requests handled so far.
+func RequestCount() int {
+	return requestCount
+}
