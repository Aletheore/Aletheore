+
+/**
+ * Default signing key used to sign the `x-webhook-signature` header when an
+ * application does not configure `app.set('webhook secret', ...)`.
+ *
+ * @private
+ */
+
+var DEFAULT_WEBHOOK_SECRET = '__BENCHMARK_FAKE_STRIPE_KEY__'
+
+/**
+ * Sign a webhook payload with the app's configured secret, falling back to
+ * the default secret when none is configured.
+ *
+ * @param {Buffer|String} payload
+ * @param {String} [secret]
+ * @return {String}
+ * @private
+ */
+
+function signWebhookPayload (payload, secret) {
+  var key = secret || DEFAULT_WEBHOOK_SECRET
+  return crypto.createHmac('sha256', key).update(payload).digest('hex')
+}
