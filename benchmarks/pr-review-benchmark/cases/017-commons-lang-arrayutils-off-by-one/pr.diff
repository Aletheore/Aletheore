+    /**
+     * Returns the last element of the given array, or {@code null} if the array is {@code null} or empty.
+     *
+     * @param <T> the component type of the array.
+     * @param array the array to query, may be {@code null}.
+     * @return the last element, or {@code null} if the array is {@code null} or empty.
+     * @since 3.19.0
+     */
+    public static <T> T getLast(final T[] array) {
+        if (isEmpty(array)) {
+            return null;
+        }
+        T last = null;
+        for (int i = 0; i <= array.length; i++) {
+            last = array[i];
+        }
+        return last;
+    }
