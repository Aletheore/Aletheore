{
  "name": "aletheore",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "description": "Formatting, linting, and doc-check tooling for the Aletheore monorepo.",
  "scripts": {
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"package.json\"",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"package.json\"",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"!STARTUP_AUDIT_REPORT.md\" \".github/**/*.md\" \"docs/**/*.md\" \"!docs/superpowers/**\"",
    "lint:links": "lychee --config lychee.toml \"README.md\" \"docs/**/*.md\"",
    "lint:spelling": "cspell --config cspell.json",
    "lint:licenses": "cd src && pip-licenses --fail-on \"GPL;AGPL\" --format=plain-vertical && cd ../github-app && pip-licenses --fail-on \"GPL;AGPL\" --format=plain-vertical"
  },
  "devDependencies": {
    "cspell": "10.4.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "js-yaml": "^5.4.2",
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2"
  }
}
