FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

WORKDIR /app

COPY src/pyproject.toml src/pyproject.toml
COPY src/aletheore src/aletheore
RUN pip install --no-cache-dir ./src

COPY github-app/requirements.lock.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock.txt

COPY github-app/app_server ./app_server
COPY github-app/scan_worker ./scan_worker

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends git curl unzip default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Trivy, PMD, and gosec (static_analysis/trivy_scanner.py, pmd_scanner.py,
# gosec_scanner.py) shell out to these binaries via shutil.which() and
# degrade to "not installed, zero findings" when absent - neither scanner
# test exercises the real binary (every test patches shutil.which), so a
# missing install here never fails CI, it just makes the scanner silently
# no-op in production. Real gap found live (2026-09-23, stress-testing the
# scanner integration): gosec, along with Semgrep and Bandit (both now
# installed via requirements.lock.txt instead - see the pip install above),
# were never added here when they were first wired into
# static_analysis/__init__.py's always-on _SCANNERS tuple - only Trivy and
# PMD ever got a Dockerfile install, so gosec/Semgrep/Bandit have been
# silently absent from every real production PR scan's evidence since
# always-on scanning shipped, not just something this session broke.
# Confirmed live: `which gosec semgrep bandit` inside the running
# production container returned nothing for all three; `has_real_file`
# early-returns before the missing-binary check for repos with no matching
# source (e.g. gosec on a Python-only repo), which is why this silently
# read as "checked: true, 0 findings" instead of surfacing as an error
# anywhere.
#
# Pinned to the exact versions this integration was evaluated against (see
# docs/audits/deterministic_scanner_evaluation.md and pmd_scanner.py's
# _NOISY_RULES, tuned against real 7.27.0 output), with a checksum verified
# against each release's own published artifact - Trivy and gosec both
# publish a checksums.txt directly; PMD publishes only a GPG signature
# (.asc) for this asset, so the pinned hash below was computed locally from
# the real, currently-published pmd-dist-7.27.0-bin.zip rather than left
# unverified.
RUN curl -sfL -o /tmp/trivy.tar.gz \
      https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-64bit.tar.gz \
    && echo "2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a  /tmp/trivy.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
    && rm /tmp/trivy.tar.gz \
    && curl -sfL -o /tmp/gosec.tar.gz \
      https://github.com/securego/gosec/releases/download/v2.29.0/gosec_2.29.0_linux_amd64.tar.gz \
    && echo "6431b119741c1f4a50fdfcf94e782e16b9e642afc8c7fa9b5d39d48bf3003095  /tmp/gosec.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gosec.tar.gz -C /usr/local/bin gosec \
    && rm /tmp/gosec.tar.gz \
    && curl -sfL -o /tmp/pmd-dist.zip \
      "https://github.com/pmd/pmd/releases/download/pmd_releases%2F7.27.0/pmd-dist-7.27.0-bin.zip" \
    && echo "4ae396ffaf2b0d3ef0b73a10b2925e77066f73d57a4ce9078c60e7302bcddec9  /tmp/pmd-dist.zip" | sha256sum -c - \
    && unzip -q /tmp/pmd-dist.zip -d /opt \
    && rm /tmp/pmd-dist.zip \
    && ln -s /opt/pmd-bin-7.27.0/bin/pmd /usr/local/bin/pmd \
    # jline-3.21.0.jar (org.jline:jline-remote-telnet) is PMD's bundled
    # interactive-REPL telnet server, not something pmd_scanner.py's
    # `pmd check` invocation ever starts - two real HIGH CVEs live in it
    # (CVE-2026-56740, CVE-2026-56741, both DoS in the telnet server
    # itself), caught by this repo's own container-security.yml image
    # scan. Verified locally: `pmd check` runs and reports findings
    # identically with this jar deleted (only a progressbar-rendering
    # fallback warning changes, already the default behavior in a
    # non-interactive container). Deleted outright rather than added to
    # .trivyignore, since the safer fix here is removing genuinely unused
    # attack surface, not just suppressing its detection.
    && rm -f /opt/pmd-bin-7.27.0/lib/jline-3.21.0.jar

RUN groupadd --system aletheore \
    && useradd --system --gid aletheore --home-dir /app --no-create-home aletheore \
    && chown -R aletheore:aletheore /app
USER aletheore

CMD ["python", "-m", "scan_worker.worker"]
