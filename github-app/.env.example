# Both blank on purpose, like every other secret below - unlike "changeme",
# a blank POSTGRES_PASSWORD makes the postgres image itself refuse to start
# rather than silently accepting a known weak default forever. Set a real
# generated password in POSTGRES_PASSWORD, then repeat that same value in
# DATABASE_URL's password field.
DATABASE_URL=postgresql://aletheore:<same-password-as-POSTGRES_PASSWORD-below>@postgres:5432/aletheore_app
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0
GITHUB_APP_ID=

# The App's private key is a multi-line PEM, which plain env-file values
# cannot hold (docker run/compose --env-file rejects newlines outright -
# confirmed empirically, not assumed). Place the downloaded .pem file at
# github-app/app-private-key.pem (docker-compose.yml mounts it and sets
# GITHUB_APP_PRIVATE_KEY_PATH for you) - GITHUB_APP_PRIVATE_KEY below is
# only a fallback for setups that inject a real env var directly.
GITHUB_APP_PRIVATE_KEY=

GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_BASE_URL=https://aletheore.com
ANTHROPIC_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Optional. Set to enable GET /v1/internal/queue-stats (RQ queue depth,
# started/failed/finished counts, worker count) for ops monitoring. The
# route returns 404 if this is unset. Bearer token, not tied to any
# installation - keep it out of client-facing tooling.
INTERNAL_METRICS_TOKEN=

# Optional production ops alerts. The scan-worker scheduler path checks
# app health, queue depth, failed jobs, and backup freshness, then sends
# alerts through the existing Resend ops-email destination.
ALETHEORE_APP_HEALTH_URL=http://app-server:8000/healthz
ALETHEORE_BACKUP_DIR=/app/backups
ALETHEORE_OPS_QUEUE_DEPTH_THRESHOLD=25
ALETHEORE_OPS_FAILED_JOBS_THRESHOLD=0

# Optional paid-tier endpoint health monitoring config is stored per
# installation through the admin API. No global base URL or latency threshold is
# read from this file.

# Optional. Set to enable transactional email (welcome, payment-failed,
# subscription-canceled). Missing key means send_transactional_email_job
# logs and skips rather than failing - nothing else depends on outbound
# mail actually working. from/reply-to both have sane defaults below if
# left unset.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Aletheore <hello@notify.aletheore.com>
EMAIL_REPLY_TO_ADDRESS=support@aletheore.com

# Optional. Set to enable the internal affiliate-program admin routes
# (POST/GET /admin/affiliates, POST /admin/affiliates/{id}/mark-paid).
# Routes return 404 if this is unset. Bearer token, deliberately separate
# from INTERNAL_METRICS_TOKEN - this one can create real Paddle discount
# codes and see revenue, a different privilege level than read-only queue
# stats. Also requires PADDLE_API_KEY to be set.
AFFILIATE_ADMIN_TOKEN=

# Free-tier PR review model routing (Community/free-plan installations,
# separate from model_tiers.py's paid-tier Luna/DeepSeek routing above).
# Not yet wired into scan_worker - placeholders reserved ahead of the
# provider-routing implementation.
GROQ_API_KEY=
# Same env var name src/aletheore/cli.py already uses for the CLI's own
# `audit --provider google` path - kept consistent rather than inventing
# a second name for the same provider.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OpenAI's discounted/data-sharing tier key - deliberately a separate var
# from OPENAI_API_KEY above (which is the paid-tier Luna key model_tiers.py
# reads) since the two have different cost/data-usage terms and must never
# be silently interchanged.
OPENAI_FREE_TIER_API_KEY=
